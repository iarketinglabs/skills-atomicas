<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITULO_FORMULARIO}} | {{CLIENTE}}</title>
<meta name="description" content="{{DESCRICAO_FORMULARIO}}">
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="assets/css/form.css">
</head>
<body>

<div class="page-content">

<header class="brand-header site-header-fixed">
  <div class="container header-row">
    <div class="brand-lockup">
      <span class="brand-wordmark">{{CLIENTE}}</span>
    </div>
    <span class="header-form-title">{{TITULO_FORMULARIO}}</span>
  </div>
  <div class="container progress-row">
    <div class="progress-bar" id="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Progresso do formulário">
      <div class="progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
  </div>
</header>

<nav class="block-nav" id="block-nav" aria-label="Navegação entre etapas">
  <div class="container" style="display:flex;flex-wrap:wrap;gap:6px;">
    <button type="button" data-step="0" title="Antes de começar">•</button>
    <button type="button" data-step="1" data-block="A">A</button>
    <!-- Adicione um botão data-step/data-block por bloco do spec -->
    <button type="button" data-step="9" title="Fechamento">✓</button>
  </div>
</nav>

<main class="container section" id="main-form">

  <form id="diagnostico-form" novalidate>

    <div class="step-panel" id="step-0" data-step="0">
      <div class="card" id="intro">
        <p class="eyebrow">Objetivo</p>
        <p>{{TEXTO_OBJETIVO}}</p>
        <p class="eyebrow">Instruções gerais</p>
        <p>{{TEXTO_INSTRUCOES}}</p>
      </div>

      <fieldset class="card-accent" id="respondente">
        <legend>Antes de começar</legend>
        <div class="field">
          <label for="respondente-select">Quem está a responder?</label>
          <select id="respondente-select" class="field-control" data-path="respondente.opcao">
            <option value="">Selecione…</option>
            <option value="outro">Outro</option>
          </select>
          <p class="error-text" id="respondente-error" hidden>Selecione quem está a responder para continuar.</p>
        </div>
        <div class="field-row conditional-field" id="respondente-outro-fields" hidden>
          <div class="field">
            <label for="respondente-nome">Nome</label>
            <input type="text" id="respondente-nome" class="field-control" data-path="respondente.nome_livre">
          </div>
          <div class="field">
            <label for="respondente-cargo">Cargo</label>
            <input type="text" id="respondente-cargo" class="field-control" data-path="respondente.cargo_livre">
          </div>
        </div>
      </fieldset>
    </div>

    <!-- ═══════════ BLOCO A (exemplo — repita este padrão para cada bloco do spec) ═══════════ -->
    <fieldset class="card step-panel" id="bloco-a" data-step="1" data-block="A" hidden>
      <legend><span class="block-badge">A</span></legend>
      <h2 class="block-title">{{NOME_DO_BLOCO}}</h2>

      <!-- Campo de texto/numérico simples -->
      <div class="field">
        <label for="a1" class="question-label">A1. {{TEXTO_DA_PERGUNTA}}</label>
        <input type="number" step="1" min="0" id="a1" class="field-control" data-path="A.A1_exemplo_numerico">
      </div>

      <!-- Escolha única (radio) com detalhe condicional -->
      <div class="field">
        <label class="question-label">A2. {{TEXTO_DA_PERGUNTA_SIM_NAO}}</label>
        <div class="radio-group" data-conditional-group="a2">
          <label class="radio-option"><input type="radio" name="a2_resposta" value="Sim" data-path="A.A2_exemplo_condicional.resposta" data-reveals="a2-detalhe"> Sim</label>
          <label class="radio-option"><input type="radio" name="a2_resposta" value="Não" data-path="A.A2_exemplo_condicional.resposta" data-reveals="a2-detalhe"> Não</label>
          <label class="radio-option"><input type="radio" name="a2_resposta" value="Não sei" data-path="A.A2_exemplo_condicional.resposta" data-reveals="a2-detalhe"> Não sei</label>
        </div>
        <div class="conditional-field" id="a2-detalhe" hidden>
          <label for="a2-detalhe-txt" class="field-hint">Detalhe (aparece só se "Sim")</label>
          <textarea id="a2-detalhe-txt" class="field-control" data-path="A.A2_exemplo_condicional.detalhe"></textarea>
        </div>
      </div>

      <!-- Tabela repetível: linhas fixas obrigatórias + linhas extras opcionais -->
      <div class="field">
        <label class="question-label">A3. {{TEXTO_DA_PERGUNTA_TABELA}}</label>
        <div class="table-scroll">
          <table class="data-table" data-array-path="A.A3_exemplo_tabela" data-template="template-linha-livre" id="tabela-exemplo">
            <thead><tr><th>Item</th><th>Valor (€)</th><th>Observação</th></tr></thead>
            <tbody id="tabela-exemplo-body">
              <!-- Linha fixa/obrigatória: sem data-optional-row -->
              <tr data-row>
                <td class="row-label" data-field="item" data-fixed="{{ITEM_FIXO}}">{{ITEM_FIXO}}</td>
                <td><input type="number" step="0.01" min="0" data-field="valor"></td>
                <td><input type="text" data-field="observacao"></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="table-actions">
          <button type="button" class="button outline" data-add-row="tabela-exemplo-body" data-template="template-linha-livre">+ Adicionar</button>
        </div>
      </div>
    </fieldset>

    <!-- ═══════════ FECHAMENTO ═══════════ -->
    <div class="step-panel" id="step-9" data-step="9" hidden>
      <fieldset class="card-accent" id="fechamento">
        <legend>Nota final</legend>
        <div class="field">
          <label for="nota-final">{{PERGUNTA_FECHAMENTO}} (opcional)</label>
          <textarea id="nota-final" class="field-control" data-path="fechamento.nota_final"></textarea>
        </div>
      </fieldset>
    </div>

    <div class="submit-bar" id="step-nav-bar">
      <button type="button" class="button outline" id="btn-back" hidden>← Voltar</button>
      <span class="step-sync-status" id="sync-status"></span>
      <span class="submit-error error-text" id="submit-error" hidden></span>
      <button type="button" class="button" id="btn-next">Avançar →</button>
    </div>
  </form>
</main>

<section id="obrigado" hidden>
  <div class="container">
    <div class="card-accent">
      <p class="eyebrow">Recebido</p>
      <h2>Obrigado pela resposta.</h2>
      <p>{{TEXTO_AGRADECIMENTO}}</p>
    </div>
  </div>
</section>

</div><!-- /.page-content -->

<!-- ═══════════ TEMPLATES DE LINHA (tabelas repetíveis) ═══════════ -->
<template id="template-linha-livre">
  <tr data-row data-optional-row="true">
    <td><input type="text" data-field="item" placeholder="Outro item"></td>
    <td><input type="number" step="0.01" min="0" data-field="valor"></td>
    <td><input type="text" data-field="observacao"></td>
  </tr>
</template>

<script src="assets/js/supabase-client.js"></script>
<script src="assets/js/form.js"></script>
</body>
</html>
